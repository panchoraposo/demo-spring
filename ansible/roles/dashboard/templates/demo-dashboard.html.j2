                <button class="btn btn-copy" type="button" data-copy-btn>Copy</button>
              </div>
            </div>
            {% endif %}
            <div class="actions">
              <a class="btn btn-primary{% if not east_gateway_url %} disabled{% endif %}" {% if east_gateway_url %}href="{{ east_gateway_url }}" target="_blank" rel="noopener"{% else %}aria-disabled="true"{% endif %}>Open East mesh</a>
            </div>
          </div>
        </article>

        <article class="card">
          <div class="card-top">
            <div class="title"><span class="icon">→</span> West mesh gateway</div>
            <span class="badge">mesh · west</span>
          </div>
          <div class="card-body">
            <p class="note"><code>banking-apps</code> — mesh failover peer. Host prefix <code>gateway.</code></p>
