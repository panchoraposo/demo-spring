                <button class="btn btn-copy" type="button" data-copy-btn>Copy</button>
              </div>
            </div>
            {% endif %}
            <div class="actions">
              <a class="btn btn-primary{% if not west_gateway_url %} disabled{% endif %}" {% if west_gateway_url %}href="{{ west_gateway_url }}" target="_blank" rel="noopener"{% else %}aria-disabled="true"{% endif %}>Open West mesh</a>
            </div>
          </div>
        </article>

        <article class="card">
          <div class="card-top">
            <div class="title"><span class="icon">⇄</span> East SI gateway</div>
            <span class="badge">SI · east</span>
          </div>
          <div class="card-body">
            <p class="note"><code>banking-si-apps</code> — Service Interconnect path. Host prefix <code>si-gateway.</code></p>
            {% if east_si_gateway_url %}
            <div class="rows">
              <div class="row">
                <span class="label">URL</span>
                <span class="value" data-copy>{{ east_si_gateway_url }}</span>
                <button class="btn btn-copy" type="button" data-copy-btn>Copy</button>
              </div>
            </div>
            {% endif %}
            <div class="actions">
              <a class="btn btn-primary{% if not east_si_gateway_url %} disabled{% endif %}" {% if east_si_gateway_url %}href="{{ east_si_gateway_url }}" target="_blank" rel="noopener"{% else %}aria-disabled="true"{% endif %}>Open East SI</a>
            </div>
          </div>
        </article>

        <article class="card">
          <div class="card-top">
            <div class="title"><span class="icon">⇄</span> West SI gateway</div>
            <span class="badge">SI · west</span>
          </div>
          <div class="card-body">
            <p class="note"><code>banking-si-apps</code> — SI failover peer. Host prefix <code>si-gateway.</code></p>
            {% if west_si_gateway_url %}
            <div class="rows">
              <div class="row">
                <span class="label">URL</span>
                <span class="value" data-copy>{{ west_si_gateway_url }}</span>
                <button class="btn btn-copy" type="button" data-copy-btn>Copy</button>
              </div>
            </div>
            {% endif %}
            <div class="actions">
              <a class="btn btn-primary{% if not west_si_gateway_url %} disabled{% endif %}" {% if west_si_gateway_url %}href="{{ west_si_gateway_url }}" target="_blank" rel="noopener"{% else %}aria-disabled="true"{% endif %}>Open West SI</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section id="clusters">
      <div class="section-head">
        <h2>Topology</h2>
        <p>Quick reference</p>
      </div>
      <div class="grid">
        <article class="card span-12">
          <div class="card-top">
            <div class="title"><span class="icon blue">◎</span> Clusters</div>
            <span class="badge">RHACM</span>
          </div>
          <div class="card-body">
            <div class="rows">
              <div class="row">
                <span class="label">Hub</span>
                <span class="value">acm — GitOps, Keycloak (sso), Conjur, Jenkins, Gitea, Nexus, Quay, Dev Spaces, TPA, Kiali</span>
                <span></span>
              </div>
              <div class="row">
                <span class="label">Managed</span>
                <span class="value">east / west — mesh (gateway.*) · SI (si-gateway.*) · regional DB · CMA</span>
                <span></span>
              </div>
              <div class="row">
                <span class="label">Short hosts</span>
                <span class="value">hub: gitea, jenkins, nexus, conjur, sso, devspaces · spokes: gateway, si-gateway</span>
                <span></span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <footer>
      <span>Banking Spring Demo · credentials dashboard</span>
      <span>Do not use these passwords outside workshop environments.</span>
    </footer>
  </div>

  <script>
    document.querySelectorAll("[data-copy-btn]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const row = btn.closest(".row");
        const el = row && row.querySelector("[data-copy]");
        if (!el) return;
        const text = el.textContent.trim();
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = "Copied";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copy";
            btn.classList.remove("copied");
          }, 1400);
        } catch (_) {
          btn.textContent = "Failed";
          setTimeout(() => { btn.textContent = "Copy"; }, 1400);
        }
      });
    });
  </script>
</body>
</html>
