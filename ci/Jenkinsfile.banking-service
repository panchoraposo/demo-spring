// CI: OpenShift Build (Maven via Nexus) → Quay SBOM/sign (RHTAS) → ACS check → GitOps.

pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    booleanParam(name: 'FORCE_BUILD', defaultValue: true, description: 'Build even without path changes (default true for manual runs)')
    // Do not name this GIT_BRANCH — the Git plugin overwrites env.GIT_BRANCH with origin/<branch>.
    string(name: 'GITOPS_BRANCH', defaultValue: 'main', description: 'Branch for GitOps commits')
  }

  environment {
    APP = "banking-service"
    APPS_NS = 'banking-apps'
    GITOPS_NS = 'openshift-gitops'
    IMAGE_TAG = "${env.BUILD_NUMBER}"
    QUAY_ORG = 'banking'
    TOOLS_DIR = "${env.WORKSPACE}/.tools"
    GITOPS_BRANCH = "${params.GITOPS_BRANCH}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh 'git rev-parse --short HEAD > .gitcommit'
        script { env.GIT_COMMIT_SHORT = readFile('.gitcommit').trim() }
      }
    }

    stage('Install oc') {
      steps {
        sh '''
          set -euo pipefail
          mkdir -p "${TOOLS_DIR}"
          if [ ! -x "${TOOLS_DIR}/oc" ]; then
            curl -fsSL "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable/openshift-client-linux.tar.gz" \
              | tar -xz -C "${TOOLS_DIR}" oc
          fi
          "${TOOLS_DIR}/oc" version --client
        '''
      }
    }

    stage('CI') {
      when {
        anyOf {
          expression { return params.FORCE_BUILD }
          changeset "apps/banking-service/**"
          changeset "ci/Jenkinsfile.app"
          changeset "ci/Jenkinsfile.banking-service"
          changeset "ci/scripts/sign-and-attest.sh"
          changeset "ci/scripts/acs-image-check.sh"
          changeset "ci/maven/**"
        }
      }
      stages {
        stage('Build & push image') {
          steps {
            sh '''
              set -euo pipefail
              export PATH="${TOOLS_DIR}:${PATH}"
              oc whoami
              # Ensure Maven settings (Nexus) are in the Docker build context.
              cp -f ci/maven/settings.xml "apps/${APP}/settings.xml"
              # Prefer -n over `oc project` — Jenkins home kubeconfig can be corrupt/incomplete.
              oc start-build "${APP}" --from-dir="apps/${APP}" --follow --wait -n "${APPS_NS}"
              oc tag "${APPS_NS}/${APP}:latest" "${APPS_NS}/${APP}:${IMAGE_TAG}" -n "${APPS_NS}"
              oc get istag "${APP}:${IMAGE_TAG}" -n "${APPS_NS}"
            '''
          }
        }

        stage('SBOM, attest & sign') {
          steps {
            withCredentials([
              string(credentialsId: 'cosign-private-key', variable: 'COSIGN_PRIVATE_KEY', optional: true),
              usernamePassword(credentialsId: 'quay-ci', usernameVariable: 'QUAY_USER', passwordVariable: 'QUAY_PASS', optional: true)
            ]) {
              sh '''
                set -euo pipefail
                export PATH="${TOOLS_DIR}:${PATH}"

                # Discover Quay route on acm when not provided
                if [ -z "${QUAY_HOST:-}" ]; then
                  QUAY_HOST="$(oc -n quay-enterprise get route -l quay-component=quay-app-route -o jsonpath='{.items[0].spec.host}' 2>/dev/null || true)"
                fi
                if [ -z "${QUAY_HOST:-}" ]; then
                  QUAY_HOST="$(oc -n quay-enterprise get route banking-quay-quay -o jsonpath='{.spec.host}' 2>/dev/null || true)"
                fi
                if [ -z "${QUAY_HOST:-}" ]; then
                  echo "WARN: Quay route not found; skipping sign/attest. Image remains in ImageStream ${APPS_NS}/${APP}:${IMAGE_TAG}"
                  echo "SKIP_SIGN=1" > .ci-sign-status
                  exit 0
                fi
                export QUAY_HOST
                echo "SKIP_SIGN=0" > .ci-sign-status
                echo "QUAY_HOST=${QUAY_HOST}" > .ci-quay.env

                if [ -n "${QUAY_USER:-}" ] && [ -n "${QUAY_PASS:-}" ]; then
                  mkdir -p "${HOME}/.docker"
                  AUTH="$(printf '%s:%s' "${QUAY_USER}" "${QUAY_PASS}" | base64 | tr -d '\n')"
                  printf '{"auths":{"%s":{"auth":"%s"}}}\n' "${QUAY_HOST}" "${AUTH}" > "${HOME}/.docker/config.json"
                fi

                # Prefer file from cosign-signing-key secret mounted by JCasC / oc extract
                chmod +x ci/scripts/sign-and-attest.sh
                # TPA_URL / TPA_OIDC_* come from Jenkins controller env (JCasC/helm-values).
                APP="${APP}" IMAGE_TAG="${IMAGE_TAG}" APPS_NS="${APPS_NS}" \
                  QUAY_HOST="${QUAY_HOST}" QUAY_ORG="${QUAY_ORG}" TOOLS_DIR="${TOOLS_DIR}" \
                  TPA_UPLOAD_REQUIRED=true \
                  ci/scripts/sign-and-attest.sh
              '''
            }
          }
        }

        stage('ACS image check') {
          steps {
            withCredentials([
              string(credentialsId: 'acs-ci-token', variable: 'ACS_API_TOKEN', optional: true),
              string(credentialsId: 'acs-central-url', variable: 'ACS_CENTRAL_URL', optional: true)
            ]) {
              sh '''
                set -euo pipefail
                export PATH="${TOOLS_DIR}:${PATH}"
                chmod +x ci/scripts/acs-image-check.sh

                if [ -z "${QUAY_HOST:-}" ] && [ -f .ci-quay.env ]; then
                  # shellcheck disable=SC1091
                  . ./.ci-quay.env
                fi
                if [ -z "${QUAY_HOST:-}" ]; then
                  QUAY_HOST="$(oc -n quay-enterprise get route -l quay-component=quay-app-route -o jsonpath='{.items[0].spec.host}' 2>/dev/null || true)"
                fi
                if [ -z "${QUAY_HOST:-}" ]; then
                  echo "WARN: Quay host unknown; ACS check skipped"
                  exit 0
                fi
                export IMAGE="${QUAY_HOST}/${QUAY_ORG}/${APP}:${IMAGE_TAG}"
                export TOOLS_DIR ACS_API_TOKEN ACS_CENTRAL_URL
                ci/scripts/acs-image-check.sh
              '''
            }
          }
        }

        stage('GitOps update') {
          steps {
            withCredentials([usernamePassword(
              credentialsId: 'github-ci',
              usernameVariable: 'GIT_USERNAME',
              passwordVariable: 'GIT_PASSWORD'
            )]) {
              sh '''
                set -euo pipefail
                OVERLAY_EAST="gitops/components/${APP}/overlays/east/kustomization.yaml"
                OVERLAY_WEST="gitops/components/${APP}/overlays/west/kustomization.yaml"
                # SI demo path shares the same Quay image; keep tags in lockstep.
                SI_OVERLAY_EAST="gitops/components/banking-si-service/overlays/east/kustomization.yaml"
                SI_OVERLAY_WEST="gitops/components/banking-si-service/overlays/west/kustomization.yaml"
                OVERLAYS="${OVERLAY_EAST} ${OVERLAY_WEST} ${SI_OVERLAY_EAST} ${SI_OVERLAY_WEST}"
                for f in ${OVERLAYS}; do
                  test -f "${f}"
                done
                for f in ${OVERLAYS}; do
                  sed -i.bak -E "s/newTag:.*/newTag: ${IMAGE_TAG}/" "${f}"
                done

                if [ -f .ci-quay.env ]; then
                  # shellcheck disable=SC1091
                  . ./.ci-quay.env
                  QUAY_REF="${QUAY_HOST}/${QUAY_ORG}/${APP}"
                  for f in ${OVERLAYS}; do
                    if grep -q 'newName:' "${f}"; then
                      sed -i.bak -E "s|newName:.*|newName: ${QUAY_REF}|" "${f}"
                    else
                      # insert newName under the images entry
                      sed -i.bak -E "/name: .*${APP}/a\\    newName: ${QUAY_REF}" "${f}"
                    fi
                  done
                fi
                for f in ${OVERLAYS}; do
                  rm -f "${f}.bak"
                done

                if [ "${GIT_PASSWORD}" = "replace-me" ] || [ -z "${GIT_PASSWORD}" ]; then
                  echo "WARN: github-ci token not configured; skipping git push of newTag=${IMAGE_TAG}."
                  echo "Set Conjur banking/github-ci/token (GitHub PAT, repo scope) for GitOps promotion."
                  echo "SKIP_GIT_PUSH=1" > .ci-gitops-status
                  exit 0
                fi

                git config user.email "jenkins@banking-demo.local"
                git config user.name "Jenkins CI"
                git add ${OVERLAYS}
                if git diff --staged --quiet; then
                  echo "No GitOps changes to commit"
                  echo "SKIP_GIT_PUSH=0" > .ci-gitops-status
                  exit 0
                fi
                git commit -m "ci(${APP}): promote signed image ${IMAGE_TAG} on east+west (${GIT_COMMIT_SHORT})"
                AUTH_URL="https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/panchoraposo/demo-spring.git"
                if git push "${AUTH_URL}" "HEAD:${GITOPS_BRANCH}"; then
                  echo "SKIP_GIT_PUSH=0" > .ci-gitops-status
                else
                  echo "WARN: git push failed; image ${APP}:${IMAGE_TAG} may be in Quay/ImageStream."
                  echo "SKIP_GIT_PUSH=1" > .ci-gitops-status
                fi
              '''
            }
          }
        }

        stage('GitOps refresh') {
          steps {
            sh '''
              set -euo pipefail
              export PATH="${TOOLS_DIR}:${PATH}"
              # GitOps roots live on hub ArgoCD (ApplicationSet banking-spoke-roots).
              for app in "banking-east-root" "banking-west-root"; do
                oc -n "${GITOPS_NS}" annotate applications.argoproj.io "${app}" \
                  argocd.argoproj.io/refresh=hard --overwrite || true
              done
              if [ -f .ci-gitops-status ] && grep -q SKIP_GIT_PUSH=1 .ci-gitops-status; then
                echo "GitOps tag bump was skipped; rolling out Deployment on this cluster to pull :latest."
                oc -n "${APPS_NS}" rollout restart "deploy/${APP}" || true
              else
                echo "OpenShift GitOps will deploy ${APP}:${IMAGE_TAG} on east+west from Git (Quay when signed)."
              fi
            '''
          }
        }
      }
    }
  }

  post {
    success {
      echo "CI OK for ${env.APP}: tag=${env.IMAGE_TAG} (build → sign → ACS → GitOps)."
    }
    unsuccessful {
      echo "CI finished with status ${currentBuild.currentResult} for ${env.APP}."
    }
  }
}
