// Banking demo CI pipeline for OpenShift Jenkins.
// Stages: clone → Maven build → tests → container build/push → GitOps image bump.
// OpenShift GitOps (Argo CD) then syncs cluster east to the updated manifests.

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 45, unit: 'MINUTES')
  }

  environment {
    https://github.com/panchoraposo/demo-spring.git = "${params.https://github.com/panchoraposo/demo-spring.git ?: 'https://github.com/panchoraposo/demo-spring.git'}"
    GIT_BRANCH = "${params.GIT_BRANCH ?: 'main'}"
    IMAGE_TAG = "${env.BUILD_NUMBER}"
    REGISTRY = "image-registry.openshift-image-registry.svc:5000"
    APPS_NS = "banking-apps"
  }

  parameters {
    string(name: 'https://github.com/panchoraposo/demo-spring.git', defaultValue: 'https://github.com/panchoraposo/demo-spring.git', description: 'Git repository URL')
    string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Git branch to build')
  }

  stages {
    stage('Git Clone') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: "*/${params.GIT_BRANCH}"]],
          userRemoteConfigs: [[url: "${params.https://github.com/panchoraposo/demo-spring.git}"]]
        ])
        sh 'git rev-parse --short HEAD > .gitcommit'
        script {
          env.GIT_COMMIT_SHORT = readFile('.gitcommit').trim()
        }
      }
    }

    stage('Maven Build') {
      parallel {
        stage('banking-service') {
          steps {
            dir('apps/banking-service') {
              sh 'mvn -B -DskipTests package'
            }
          }
        }
        stage('api-gateway') {
          steps {
            dir('apps/api-gateway') {
              sh 'mvn -B -DskipTests package'
            }
          }
        }
      }
    }

    stage('Tests') {
      parallel {
        stage('banking-service tests') {
          steps {
            dir('apps/banking-service') {
              sh 'mvn -B test'
            }
          }
          post {
            always {
              junit allowEmptyResults: true, testResults: 'apps/banking-service/target/surefire-reports/*.xml'
            }
          }
        }
        stage('api-gateway tests') {
          steps {
            dir('apps/api-gateway') {
              sh 'mvn -B test'
            }
          }
          post {
            always {
              junit allowEmptyResults: true, testResults: 'apps/api-gateway/target/surefire-reports/*.xml'
            }
          }
        }
      }
    }

    stage('Build & Push Images') {
      steps {
        script {
          def apps = ['banking-service', 'api-gateway']
          for (app in apps) {
            sh """
              set -euo pipefail
              oc project ${APPS_NS}
              oc start-build ${app} --from-dir=apps/${app} --follow --wait || \
                oc new-build --name=${app} --binary --strategy=docker -n ${APPS_NS} && \
                oc start-build ${app} --from-dir=apps/${app} --follow --wait -n ${APPS_NS}
              oc tag ${APPS_NS}/${app}:latest ${APPS_NS}/${app}:${IMAGE_TAG}
            """
          }
        }
      }
    }

    stage('GitOps Update') {
      steps {
        sh '''
          set -euo pipefail
          # Bump image tags in east overlays so OpenShift GitOps syncs the new digests/tags
          for overlay in \
            gitops/components/banking-service/overlays/east/kustomization.yaml \
            gitops/components/api-gateway/overlays/east/kustomization.yaml
          do
            sed -i.bak -E "s/newTag:.*/newTag: ${IMAGE_TAG}/" "${overlay}"
            rm -f "${overlay}.bak"
          done

          git config user.email "jenkins@banking-demo.local"
          git config user.name "Jenkins CI"
          git add gitops/components/*/overlays/east/kustomization.yaml
          if git diff --staged --quiet; then
            echo "No GitOps changes to commit"
          else
            git commit -m "ci: promote images to tag ${IMAGE_TAG} (${GIT_COMMIT_SHORT})"
            # Requires credentials with push access (configure in Jenkins)
            git push origin HEAD:${GIT_BRANCH}
          fi
        '''
      }
    }

    stage('GitOps Sync') {
      steps {
        sh '''
          set -euo pipefail
          # Trigger Argo CD refresh/sync for east applications (cluster-local)
          if command -v argocd >/dev/null 2>&1; then
            argocd app sync banking-service --assumeYes || true
            argocd app sync api-gateway --assumeYes || true
          else
            # Fallback: annotate Applications for hard refresh
            oc -n openshift-gitops annotate application banking-service \
              argocd.argoproj.io/refresh=hard --overwrite || true
            oc -n openshift-gitops annotate application api-gateway \
              argocd.argoproj.io/refresh=hard --overwrite || true
          fi
          echo "OpenShift GitOps will reconcile cluster east to the updated manifests."
        '''
      }
    }
  }

  post {
    success {
      echo "CI succeeded. Image tag=${IMAGE_TAG}. GitOps owns deployment to east."
    }
    failure {
      echo "CI failed. Inspect stage logs above."
    }
  }
}
